# Copy to .env and fill in — never commit .env
# Proxy pool: spider.py builds a ProxyRotator from the first shape present.
# Shape A — full URLs (comma-separated):
#   PROXY_LIST=http://user:pass@host1:port1,http://user:pass@host2:port2
# Shape B — host:port list + shared creds (matches the proxy dashboard):
#   PROXY_HOSTS=1.2.3.4:6754,5.6.7.8:6014
#   PROXY_USER=...
#   PROXY_PASS=...
# Shape C — single:
#   PROXY_URL=http://user:pass@host:port
PROXY_LIST=
PROXY_HOSTS=
PROXY_USER=
PROXY_PASS=
PROXY_URL=

# Discord webhook for break alerts (P6)
DISCORD_WEBHOOK_URL=

# Neon dual-write (P3) — optional
DATABASE_URL_NEON=

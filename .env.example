# Copy this file to .env and fill in your real values
# NEVER commit .env to the repo
PROXY_USER=your_proxy_username
PROXY_PASS=your_proxy_password
PROXY_LIST=host1:port1,host2:port2,host3:port3

# Discord/Slack webhook URL for failure notifications (optional)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url-here

# PostgreSQL connection string (optional - skips DB insert if not set)
# Local: postgresql://user:pass@localhost:5432/hn_scraper
# Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional local Docker copy (dual-write alongside DATABASE_URL)
LOCAL_DATABASE_URL=postgresql://postgres:testpass@localhost:5432/hn_scraper

# Local runs only: show the browser window so you can solve old-style
# checkbox CF challenges manually. Does NOT help with managed turnstile
# (the common skelbiu.lt case) — those have no UI, just a fingerprint
# check. If you're hitting "Verifying..." with no checkbox, set up a
# proxy instead (PROXY_LIST above). When a proxy is configured,
# scrapling auto-solves CF and STEALTHY_HEADLESS is ignored.
#
#   STEALTHY_HEADLESS=false python3 -m run_daily
#
# Values: 1/true/yes/on = headless (default, no window); anything else
# (or empty) = also headless. Only false/0/no/off shows the window.
STEALTHY_HEADLESS=
